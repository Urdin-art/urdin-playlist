<?php
header('Content-Type: application/json');
header('Access-Control-Allow-Origin: *'); 

$method = $_SERVER['REQUEST_METHOD'];
$master_playlist_path = '../public/songs-master.json';

// Endpoint para obtener la lista maestra de canciones
if ($method === 'GET') {
    if (file_exists($master_playlist_path)) {
        $master_playlist = file_get_contents($master_playlist_path);
        echo $master_playlist;
    } else {
        http_response_code(404);
        echo json_encode(['error' => 'Master playlist not found.']);
    }
}

// Función para procesar y redimensionar imágenes con GD
function process_image($file, $target_dir, $max_width, $max_height) {
    if (!$file || $file['error'] !== UPLOAD_ERR_OK) {
        return null;
    }

    $tmp_name = $file['tmp_name'];
    $file_ext = strtolower(pathinfo($file['name'], PATHINFO_EXTENSION));
    $file_name = uniqid() . '.jpg'; // Guardar todo como JPG para consistencia
    $target_path = $target_dir . $file_name;

    list($width, $height, $type) = getimagesize($tmp_name);

    $src_image = null;
    switch ($type) {
        case IMAGETYPE_JPEG:
            $src_image = imagecreatefromjpeg($tmp_name);
            break;
        case IMAGETYPE_PNG:
            $src_image = imagecreatefrompng($tmp_name);
            break;
        case IMAGETYPE_WEBP:
            $src_image = imagecreatefromwebp($tmp_name);
            break;
        default:
            return null; // Tipo de imagen no soportado
    }

    $ratio = $width / $height;
    if ($max_width / $max_height > $ratio) {
        $new_width = $max_height * $ratio;
        $new_height = $max_height;
    } else {
        $new_width = $max_width;
        $new_height = $max_width / $ratio;
    }

    $dst_image = imagecreatetruecolor($new_width, $new_height);
    imagecopyresampled($dst_image, $src_image, 0, 0, 0, 0, $new_width, $new_height, $width, $height);

    // Guardar la nueva imagen
    imagejpeg($dst_image, $target_path, 85); // Calidad del 85%

    // Liberar memoria
    imagedestroy($src_image);
    imagedestroy($dst_image);

    return str_replace('../public', '', $target_path);
}

if ($method === 'POST') {
    try {
        // Rutas de destino
        $audio_dir = '../public/audio/';
        $album_art_dir = '../public/albums/';
        $lyrics_dir = '../public/lyrics/';

        // Crear directorios si no existen
        if (!is_dir($audio_dir)) mkdir($audio_dir, 0755, true);
        if (!is_dir($album_art_dir)) mkdir($album_art_dir, 0755, true);
        if (!is_dir($lyrics_dir)) mkdir($lyrics_dir, 0755, true);

        // Obtener datos del formulario
        $song_data = $_POST;

        // Función auxiliar para subir archivos (sin procesar)
        function upload_raw_file($file, $target_dir) {
            if ($file && $file['error'] === UPLOAD_ERR_OK) {
                $file_name = uniqid() . '_' . basename($file['name']);
                $target_path = $target_dir . $file_name;
                if (move_uploaded_file($file['tmp_name'], $target_path)) {
                    return str_replace('../public', '', $target_path);
                }
            }
            return null;
        }

        // Manejar subida de archivos
        $file_paths = [];
        $file_paths['audioFile'] = upload_raw_file($_FILES['audioFile'] ?? null, $audio_dir);
        $file_paths['albumArt'] = process_image($_FILES['albumArt'] ?? null, $album_art_dir, 500, 500); // Redimensionar a 500x500
        $file_paths['lyricsFile'] = upload_raw_file($_FILES['lyricsFile'] ?? null, $lyrics_dir);
        
        // Comprobar que el audio se ha subido
        if (!$file_paths['audioFile']) {
            throw new Exception('El archivo de audio es obligatorio y no se ha subido correctamente.');
        }

        // Combinar datos del POST con las rutas de los archivos
        $new_song_entry = [
            'id' => $song_data['id'],
            'title' => $song_data['title'],
            'artist' => $song_data['artist'],
            'album' => $song_data['album'],
            'duration' => '0:00', // Placeholder, se podría calcular en el frontend o con una librería en PHP
            'audioFile' => $file_paths['audioFile'],
            'albumArt' => $file_paths['albumArt'] ?? '/albums/placeholder.png',
            'lyricsFile' => $file_paths['lyricsFile'] ?? '',
        ];

        // Actualizar el JSON maestro
        $master_playlist = json_decode(file_get_contents($master_playlist_path), true);
        $master_playlist[] = $new_song_entry;
        file_put_contents($master_playlist_path, json_encode($master_playlist, JSON_PRETTY_PRINT));

        http_response_code(201);
        echo json_encode(['status' => 'success', 'message' => 'Canción añadida correctamente.', 'song' => $new_song_entry]);

    } catch (Exception $e) {
        http_response_code(400);
        echo json_encode(['status' => 'error', 'message' => $e->getMessage()]);
    }
}

// Aquí añadiremos la lógica para DELETE.
?>